---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Encuentra Recursos para Construir Crédito con ITIN';
const description =
  'Explora nuestras guías independientes para encontrar herramientas de crédito, tarjetas aseguradas y préstamos para construir historial crediticio con un ITIN.';
---
<BaseLayout title={title} description={description} path="/es/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Encuentra recursos para construir crédito con un ITIN</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Explora nuestras guías para encontrar herramientas de crédito, tarjetas
        aseguradas y préstamos para construir historial crediticio con un ITIN,
        sin Seguro Social.
      </p>
      <a class="btn btn-primary btn-lg" href="/es/itin-credit-score-guide">Ver guías de crédito con ITIN</a>
      <p style="margin-top:20px"><a href="/es/articles">Ver todas las guías &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
