---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Find ITIN Credit Building Resources';
const description =
  'Browse our independent guides to find credit-building tools, secured cards, and credit-builder loans available to ITIN holders.';
---
<BaseLayout title={title} description={description} path="/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Find ITIN Credit Building Resources</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Browse our guides to find credit-building tools, secured cards, and
        credit-builder loans available to ITIN holders, no SSN required.
      </p>
      <a class="btn btn-primary btn-lg" href="/itin-credit-score-guide">Browse Credit Building Guides</a>
      <p style="margin-top:20px"><a href="/articles">See all guides &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
