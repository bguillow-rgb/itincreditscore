---
import { SITE } from '../consts';
import { getLangFromUrl, altPath } from '../i18n/ui';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import Analytics from '../components/Analytics.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Self-hosted brand typography ("The Report" identity): Newsreader for
// headings/prose, Public Sans (the US federal design system face) for UI.
// Bundled locally — no Google Fonts CDN request, no third-party call.
import '@fontsource-variable/newsreader';
import '@fontsource-variable/public-sans';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Canonical path on this site, e.g. '/about'. Empty on homepage.
  path?: string;
  noindex?: boolean;
  // Suppress global Organization + WebSite schema (articles emit their own
  // type-specific schema and we avoid duplication where needed).
  suppressGlobalSchema?: boolean;
  // Per-page social card path under /og (e.g. '/og/itin-mortgage.png').
  // Falls back to the generic brand card when omitted.
  ogImage?: string;
}

const lang = getLangFromUrl(Astro.url);
const isEs = lang === 'es';

const {
  title,
  description = isEs ? SITE.descriptionEs : SITE.description,
  noindex = false,
  suppressGlobalSchema = false,
  ogImage = '/og.png',
} = Astro.props;
const ogImageUrl = `${SITE.url}${ogImage}`;

// Canonical + hreflang derived from the actual URL so /es pages are correct.
const pathname =
  (Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/\/$/, '') || '/');
const abs = (p: string) => `${SITE.url}${p === '/' ? '' : p}`;
const canonical = abs(pathname);
const enHref = abs(altPath(pathname, 'en'));
const esHref = abs(altPath(pathname, 'es'));

const homeTitle = isEs ? SITE.homeTitleEs : SITE.homeTitle;

// Brand suffix is appended ONLY when the finished title still fits Google's
// ~60-character cut. Appending it unconditionally is what broke this site:
// ` | ITIN Credit Score` is 20 characters, and the 2026-08-17 audit measured
// 123 of 307 built pages rendering over 60 — including every page in the
// Bing/Spanish rewrite set (67-97 characters). The words that distinguish each
// page were being truncated out of the snippet the searcher actually reads.
//
// A guard beats a one-time cleanup: no future title can be pushed past the cut
// by the suffix. The brand is still in the domain, which Google renders next to
// the title anyway.
//
// Same defect and same fix as itinlending.net (2026-08-10) and
// itincreditcard.com (2026-08-17, commit 619888b). On itinlending this produced
// that site's first Spanish click within the week.
const TITLE_MAX = 60;
const brandSuffix = ` | ${SITE.name}`;
const fullTitle =
  title === SITE.name
    ? `${SITE.name} | ${homeTitle}`
    : title.length + brandSuffix.length <= TITLE_MAX
      ? `${title}${brandSuffix}`
      : title;
---
<!doctype html>
<html lang={isEs ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content={SITE.theme.primary} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} | Guides`} href="/rss.xml" />

    {!suppressGlobalSchema && <OrganizationSchema />}
    {!suppressGlobalSchema && <WebSiteSchema />}

    <Analytics />
    <slot name="head" />
  </head>
  <body>
    {/* English only. A pay-per-call credit-repair buyer rejected campaign
        #350906 over the FHA wording on /es/apply: loan messaging reads as the
        wrong audience for a credit-repair offer. Removed 2026-08-17. */}
    {lang !== 'es' && (
      <div class="announce-bar">
        FHA home loans for ITIN buyers, with 3.5% down.* <a href="/apply">See if you qualify</a>
      </div>
    )}
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
